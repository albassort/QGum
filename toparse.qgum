CONNECT postgres pg_conn(
  host = '127.0.0.1',
  conn = 'DATABASE=db USER=user password=password',  
  port = 50124
);

create plot varname(test = 'a');
create plot varname1(test = 'a');

insert into varname1(x,y) values with pg_conn
  SELECT
      char,
      sum(count)
  FROM
      training_data.CharacterCounts
  WHERE
      char > 1000
  GROUP BY
      char
  LIMIT 100;

SHOW varname1;
